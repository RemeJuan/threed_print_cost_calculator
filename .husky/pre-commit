#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

export PATH="/opt/homebrew/bin:$PATH"

# Format staged Dart files without touching unrelated files.
git diff --cached --name-only --diff-filter=ACM -z -- '*.dart' |
  xargs -0 -r sh -c '
    for file do
      fvm dart format "$file" && git add -- "$file" || exit 1
    done
  ' sh && fvm flutter analyze
